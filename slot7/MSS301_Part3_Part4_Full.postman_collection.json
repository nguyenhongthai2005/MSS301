	"item": [
		{
			"name": "01. Part 4 - Keycloak Token (:8181)",
			"description": "Lấy JWT Access Token từ Keycloak thông qua flow OAuth2 Client Credentials.",
			"item": [
				{
					"name": "01.1 Lấy JWT Access Token (Client Credentials)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var data = pm.response.json();",
									"pm.test(\"Có access_token\", function () {",
									"    pm.expect(data.access_token).to.be.a(\"string\");",
									"});",
									"// Tự động lưu access_token vào biến collection để các request sau dùng lại",
									"pm.collectionVariables.set(\"jwt_token\", data.access_token);",
									"console.log(\"Saved JWT Token: \" + data.access_token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "{{client_id}}",
									"type": "text"
								},
								{
									"key": "client_secret",
									"value": "{{client_secret}}",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{keycloak_url}}/protocol/openid-connect/token",
							"host": [
								"{{keycloak_url}}"
							],
							"path": [
								"protocol",
								"openid-connect",
								"token"
							]
						}
					},
					"response": []
				},
				{
					"name": "01.2 Thử sai Client Secret (Bị từ chối 400/401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 400 or 401\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([400, 401]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "{{client_id}}",
									"type": "text"
								},
								{
									"key": "client_secret",
									"value": "mat_khau_sai_123",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{keycloak_url}}/protocol/openid-connect/token",
							"host": [
								"{{keycloak_url}}"
							],
							"path": [
								"protocol",
								"openid-connect",
								"token"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "02. Part 4 - Secured Gateway (:9000)",
			"description": "Kiểm thử các kịch bản bảo mật tại Gateway: Chặn 401 khi không có hoặc sai token, và Cho phép 200/201 khi có Bearer token.",
			"item": [
				{
					"name": "02.1 Chặn 401 - Gọi API KHÔNG gửi Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401 Unauthorized\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"pm.test(\"Header có WWW-Authenticate\", function () {",
									"    pm.response.to.have.header(\"WWW-Authenticate\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gateway_url}}/api/products",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"products"
							]
						}
					},
					"response": []
				},
				{
					"name": "02.2 Chặn 401 - Gửi Token rác hoặc token giả mạo",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401 Unauthorized\", function () {",
									"    pm.response.to.have.status(401);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer token_gia_mao_khong_hop_le_12345"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/api/products",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"products"
							]
						}
					},
					"response": []
				},
				{
					"name": "02.3 Cho phép 200 - Lấy danh sách sản phẩm (kèm JWT Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Response is an array\", function () {",
									"    pm.expect(pm.response.json()).to.be.an(\"array\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/api/products",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"products"
							]
						}
					},
					"response": []
				},
				{
					"name": "02.4 Cho phép 200 - Kiểm tra tồn kho (kèm JWT Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Body is true\", function () {",
									"    pm.expect(pm.response.text()).to.eql(\"true\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/api/inventory?skuCode=iphone_15&quantity=100",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"inventory"
							],
							"query": [
								{
									"key": "skuCode",
									"value": "iphone_15"
								},
								{
									"key": "quantity",
									"value": "100"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "02.5 Cho phép 201 - Đặt hàng thành công (kèm JWT Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Order placed message\", function () {",
									"    pm.expect(pm.response.text()).to.include(\"Order Placed Successfully\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"skuCode\": \"iphone_15\",\n    \"price\": 1000,\n    \"quantity\": 1\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/order",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"order"
							]
						}
					},
					"response": []
				},
				{
					"name": "02.6 Cho phép 200 - Actuator Health mở tự do (Không cần Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Status UP\", function () {",
									"    pm.expect(pm.response.json().status).to.eql(\"UP\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gateway_url}}/actuator/health",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"actuator",
								"health"
							]
						}
					},
					"response": []
				}
			]
		},
