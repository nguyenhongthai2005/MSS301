									"pm.test(\"Body should be false\", function () {",
									"    pm.expect(pm.response.text()).to.eql(\"false\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gateway_url}}/api/inventory?skuCode=iphone_15&quantity=101",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"inventory"
							],
							"query": [
								{
									"key": "skuCode",
									"value": "iphone_15"
								},
								{
									"key": "quantity",
									"value": "101"
								}
							]
						}
					},
					"response": []
