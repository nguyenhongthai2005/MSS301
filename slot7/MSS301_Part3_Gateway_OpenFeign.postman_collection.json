	"item": [
		{
			"name": "01. API Gateway (:9000 - Cổng duy nhất)",
			"description": "Các request gọi tập trung qua API Gateway cổng 9000 để Gateway tự động điều hướng sang các Microservices tương ứng.",
			"item": [
				{
					"name": "01.1 Lấy danh sách sản phẩm (via Gateway)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Response is an array of products\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an(\"array\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gateway_url}}/api/products",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"products"
							]
						}
					},
					"response": []
				},
				{
					"name": "01.2 Tạo sản phẩm mới (via Gateway)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"iPhone 15 Pro\",\n    \"description\": \"Apple flagship smartphone with A17 Pro\",\n    \"price\": 1200\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/products",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"products"
							]
						}
					},
					"response": []
				},
				{
					"name": "01.3 Kiểm tra tồn kho - CÒN HÀNG (via Gateway)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Body should be true\", function () {",
									"    pm.expect(pm.response.text()).to.eql(\"true\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{gateway_url}}/api/inventory?skuCode=iphone_15&quantity=100",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"inventory"
							],
							"query": [
								{
									"key": "skuCode",
									"value": "iphone_15"
								},
								{
									"key": "quantity",
									"value": "100"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "01.4 Kiểm tra tồn kho - HẾT HÀNG (via Gateway)",
