				{
					"name": "01.6 Đặt hàng THẤT BẠI do hết hàng (via Gateway - OpenFeign chặn)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 500 (or 409)\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([500, 409]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
