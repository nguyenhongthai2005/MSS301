{
	"info": {
		"name": "Product Service API",
		"description": "API collection for Product Service (CRUD)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Create Product",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"iPhone 15\",\n  \"description\": \"Latest Apple smartphone\",\n  \"price\": 999.99\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/product/",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "product", ""]
				}
			}
		},
		{
			"name": "Get All Products",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/product/",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "product", ""]
				}
			}
		},
		{
			"name": "Update Product",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"iPhone 15 Pro\",\n  \"description\": \"Updated Apple smartphone\",\n  \"price\": 1099.99\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/product/<id_san_pham_o_day>",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "product", "<id_san_pham_o_day>"]
				}
			}
		},
		{
			"name": "Delete Product",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/product/<id_san_pham_o_day>",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "product", "<id_san_pham_o_day>"]
				}
			}
		}
	]
}
