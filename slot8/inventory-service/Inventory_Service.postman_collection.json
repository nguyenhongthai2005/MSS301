{
	"info": {
		"_postman_id": "inventory-service-collection",
		"name": "Inventory Service",
		"description": "Postman Collection for Inventory Service API Testing based on inventory-service.md",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Check In Stock - Enough Quantity (True)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{inventory_base_url}}/api/inventory?skuCode=iphone_15&quantity=100",
					"host": [
						"{{inventory_base_url}}"
					],
					"path": [
						"api",
						"inventory"
					],
					"query": [
						{
							"key": "skuCode",
							"value": "iphone_15"
						},
						{
							"key": "quantity",
							"value": "100"
						}
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response body is true\", function () {",
							"    pm.expect(pm.response.text()).to.eql(\"true\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "2. Check In Stock - Not Enough Quantity (False)",
